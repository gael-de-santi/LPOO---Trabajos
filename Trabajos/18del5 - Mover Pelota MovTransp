float x, y, dx, dy;

void setup(){
size(800, 600);


x = width/2;
y = height/2;
}

void draw(){
background(0);

int tam = height/10;

int dx = 0;
int dy = 0;

fill(255);
if(mousePressed && dist(x, y, pmouseX, pmouseY) < tam/2){
dx = mouseX - pmouseX;
dy = mouseY - pmouseY;
fill(255, 0, 0);
}

x = x + dx;
y = y + dy;

ellipse(x, y, tam, tam);
}
