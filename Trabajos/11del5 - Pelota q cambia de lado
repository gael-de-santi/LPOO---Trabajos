PVector pos, vel;

void setup(){
size(800, 600);
int w = width, h = height; 

pos = new PVector(w/2, h/2);
vel = new PVector(4, 6); //vector que calcula y devuelve posicion inicial y velocidad
}

void draw(){
background(255, 0, 0);

int w = width;

int valCirculo = w/20; //valor del ellipse



println(pos.x, pos.y);
pos.add(vel);

fill(0);
ellipse(pos.x, pos.y, valCirculo, valCirculo); //circulo

if(pos.x > width || pos.x < 0){
pos.x = pos.x * 0;
}//si pasa los bordes en x aparece en el otro lado


if(pos.y > height || pos.y < 0){
pos.y = pos.y * 0;
}//si pasa los bordes en y aparece en el otro lado

}

